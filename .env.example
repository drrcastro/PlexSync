# Configuração do Servidor Plex
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=o_teu_token_do_plex

# Playlists a sincronizar (separadas por vírgula)
PLAYLISTS_TO_SYNC=❤️ Tracks, Carro, Populares

# Destino no disco / partilha de rede
BASE_TARGET_DIR=/mnt/usb/musica_carro

# Sub-pastas (opcionais, com valores predefinidos)
MEDIA_SUBDIR=Media
PLAYLISTS_SUBDIR=Playlists

